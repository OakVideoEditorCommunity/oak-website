server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json application/wasm;

    # The docs moved to https://docs.oakvideoeditor.org. Answer with real 301s
    # (SEO-friendly, no JS needed); the path after /docs is preserved and the
    # locale-prefixed variant (/zh/docs/...) maps the same way.
    location ~ ^/(?:zh/)?docs(?:/(?<docspath>.*))?$ {
        return 301 https://docs.oakvideoeditor.org/$docspath;
    }

    # Same-origin API calls are forwarded to the backend. API_UPSTREAM is
    # substituted by the nginx entrypoint (envsubst) at container start.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets are immutable.
    location /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Pre-rendered pages are served as files; everything else (dynamic routes
    # such as /releases/<version>) boots the SPA fallback and renders
    # client-side.
    location / {
        try_files $uri $uri/index.html $uri.html /200.html;
    }
}
